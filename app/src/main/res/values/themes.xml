<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Leanback TV Theme -->
    <style name="Theme.Leanback.TvClient" parent="Theme.Leanback">
        <item name="colorPrimary">@color/tv_accent</item>
        <item name="colorPrimaryDark">@color/tv_bg_dark</item>
        <item name="colorAccent">@color/tv_accent</item>
        <item name="defaultBrandColor">@color/tv_bg_default</item>
        <item name="android:windowBackground">@color/tv_bg_default</item>
    </style>

    <!-- Leanback Fullscreen Video Player Theme -->
    <style name="Theme.Leanback.TvClient.Fullscreen" parent="Theme.Leanback">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Dialog Theme for D-pad Keypad & Server Select -->
    <style name="Theme.TvDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@drawable/bg_dialog_rounded</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:textColorPrimary">@color/tv_text_primary</item>
    </style>
</resources>
