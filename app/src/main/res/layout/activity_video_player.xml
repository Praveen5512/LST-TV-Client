<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <!-- Media3 Player Surface -->
    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false" />

    <!-- Buffering Spinner Overlay -->
    <LinearLayout
        android:id="@+id/bufferingOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_dialog_rounded"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/tv_accent" />

        <TextView
            android:id="@+id/tvBufferingMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Buffering stream..."
            android:textColor="@color/tv_text_primary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Visual Seek Toast Indicator (e.g. +10s / -10s) -->
    <TextView
        android:id="@+id/tvSeekIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_dialog_rounded"
        android:paddingStart="28dp"
        android:paddingTop="14dp"
        android:paddingEnd="28dp"
        android:paddingBottom="14dp"
        android:text="+10s"
        android:textColor="@color/tv_accent"
        android:textSize="26sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Interactive On-Screen HUD Overlay -->
    <RelativeLayout
        android:id="@+id/hudOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_video_hud_gradient"
        android:padding="32dp">

        <!-- Top Info Header -->
        <LinearLayout
            android:id="@+id/topInfoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvVideoTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Video Title"
                android:textColor="@color/tv_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVideoMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="1080p • HTTP 206 Direct Stream"
                android:textColor="@color/tv_accent"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Bottom Controls Bar -->
        <LinearLayout
            android:id="@+id/bottomControlsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:orientation="vertical">

            <!-- Progress Bar -->
            <SeekBar
                android:id="@+id/seekBarProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:progressBackgroundTint="@color/tv_surface_elevated"
                android:progressTint="@color/tv_accent"
                android:thumbTint="@color/tv_accent" />

            <!-- Time Display Row -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <TextView
                    android:id="@+id/tvCurrentPosition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:text="00:00"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvTotalDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:text="00:00"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="14sp" />
            </RelativeLayout>

            <!-- Remote Guide Hints -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="D-pad: [OK] Play/Pause • [Left/Right] Seek ±10s (Hold ±30s) • [Up] Details • [Down] Tracks"
                android:textColor="@color/tv_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

    </RelativeLayout>

</FrameLayout>
