<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_default">

    <!-- 1. Ambient Hero Backdrop (Full Screen) -->
    <ImageView
        android:id="@+id/ivHeroBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Ambient Backdrop"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_default_cinema" />

    <!-- 2. Dark Vignette Scrim Overlay -->
    <View
        android:id="@+id/vHeroOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_hero_gradient" />

    <!-- 3. Fullscreen Main Layout (No left navigation rail) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Status Bar -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="32dp"
            android:paddingTop="20dp"
            android:paddingEnd="36dp"
            android:paddingBottom="12dp">

            <!-- App Title -->
            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="@string/app_name"
                android:textColor="@color/tv_text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Default External Player Capsule (Clickable/Focusable to edit/change default player) -->
            <LinearLayout
                android:id="@+id/containerPlayerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:background="@drawable/selector_server_capsule"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="16dp"
                android:paddingBottom="7dp">

                <ImageView
                    android:id="@+id/ivPlayerIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:contentDescription="Player Icon"
                    android:src="@drawable/ic_video"
                    android:tint="@color/tv_accent" />

                <TextView
                    android:id="@+id/tvPlayerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Player: Choose External"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Server Connection Status Capsule (Clickable/Focusable) -->
            <LinearLayout
                android:id="@+id/containerServerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_server_capsule"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="7dp"
                android:paddingEnd="16dp"
                android:paddingBottom="7dp">

                <!-- Online / Offline Dot -->
                <ImageView
                    android:id="@+id/ivServerDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:contentDescription="Server Dot"
                    android:src="@drawable/ic_red_dot" />

                <TextView
                    android:id="@+id/tvServerStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="No Connected Server"
                    android:textColor="#E2E8F0"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Wi-Fi Icon -->
            <ImageView
                android:id="@+id/ivWifiStatus"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginStart="16dp"
                android:contentDescription="Wi-Fi Signal"
                android:src="@drawable/ic_wifi" />

            <!-- Digital Clock -->
            <TextView
                android:id="@+id/tvClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:fontFamily="sans-serif-medium"
                android:text="--:--"
                android:textColor="#E2E8F0"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- 4. Content States Container (Loading / Disconnected / Media List View) -->
        <FrameLayout
            android:id="@+id/mainContentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="32dp"
            android:paddingEnd="36dp"
            android:paddingBottom="20dp">

            <!-- STATE A: Loading Screen (Requirement 3: While connecting to server) -->
            <LinearLayout
                android:id="@+id/layoutLoading"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/pbLoading"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/tv_accent" />

                <TextView
                    android:id="@+id/tvLoadingTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="Connecting to Media Server…"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLoadingSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="sans-serif"
                    android:text="Validating server connection and loading media library…"
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- STATE B: No Connected Server Screen (Requirement 1) -->
            <LinearLayout
                android:id="@+id/layoutNoServer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivNoServerIcon"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:contentDescription="No Server Icon"
                    android:src="@drawable/ic_server"
                    android:tint="@color/tv_text_muted" />

                <TextView
                    android:id="@+id/tvNoServerTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:text="There are no connected server"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNoServerSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:maxWidth="480dp"
                    android:text="Connect to a media server on your local Wi-Fi or hotspot to browse and stream files."
                    android:textColor="@color/tv_text_secondary"
                    android:textSize="14sp" />

                <!-- Button to navigate to connect server options -->
                <Button
                    android:id="@+id/btnConnectServer"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="24dp"
                    android:background="@drawable/selector_tv_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="32dp"
                    android:paddingEnd="32dp"
                    android:text="Connect to Server"
                    android:textColor="@color/tv_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- STATE C: Connected Media List View (Full Screen Width) -->
            <LinearLayout
                android:id="@+id/layoutContent"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- Header Breadcrumbs / Title Row -->
                <LinearLayout
                    android:id="@+id/layoutHeaderInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="4dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:id="@+id/tvHeaderBreadcrumb"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="📁 Shared Folders"
                        android:textColor="@color/tv_text_primary"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <!-- Item Count Badge -->
                    <TextView
                        android:id="@+id/tvHeaderCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_format_badge"
                        android:fontFamily="sans-serif-medium"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="0 items"
                        android:textColor="@color/tv_accent"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Vertical List View for files (Full width) -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMediaList"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:fadeScrollbars="true"
                    android:focusable="true"
                    android:paddingBottom="24dp"
                    android:scrollbars="vertical" />

                <!-- Empty Folder / Category Message -->
                <LinearLayout
                    android:id="@+id/layoutEmptyList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvEmptyListMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="No files found on server"
                        android:textColor="@color/tv_text_muted"
                        android:textSize="16sp" />
                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
