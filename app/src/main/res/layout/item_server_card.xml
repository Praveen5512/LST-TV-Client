<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- Main Server Clickable Body -->
    <LinearLayout
        android:id="@+id/btnConnectServer"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_weight="1"
        android:background="@drawable/selector_tv_button"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="12dp">

        <!-- Server Icon -->
        <ImageView
            android:id="@+id/ivServerIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="Server Icon"
            android:src="@drawable/ic_server" />

        <!-- Name & Host Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvServerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Pixel 8 Pro"
                android:textColor="@color/tv_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvServerUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="http://192.168.1.150:8080"
                android:textColor="@color/tv_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Status Pill -->
        <TextView
            android:id="@+id/tvStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tv_button_normal"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="@string/server_status_online"
            android:textColor="@color/tv_online"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Connection Management Action Buttons (Edit & Delete) -->
    <LinearLayout
        android:id="@+id/layoutActions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Edit Button -->
        <ImageButton
            android:id="@+id/btnEditServer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/selector_keypad_button"
            android:contentDescription="@string/btn_edit"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_edit" />

        <!-- Delete Button -->
        <ImageButton
            android:id="@+id/btnDeleteServer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/selector_danger_button"
            android:contentDescription="@string/btn_delete"
            android:focusable="true"
            android:padding="8dp"
            android:src="@drawable/ic_delete" />
    </LinearLayout>

</LinearLayout>
