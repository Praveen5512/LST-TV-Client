<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/selector_keypad_button"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="20dp"
    android:paddingBottom="14dp">

    <!-- Server Icon -->
    <ImageView
        android:id="@+id/ivServerIcon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="Server Icon"
        android:src="@drawable/ic_server" />

    <!-- Name & Host Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvServerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pixel 8 Pro"
            android:textColor="@color/tv_text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvServerUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="http://192.168.1.150:8080"
            android:textColor="@color/tv_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Online Status Pill -->
    <TextView
        android:id="@+id/tvStatusBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_tv_button_normal"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="@string/server_status_online"
        android:textColor="@color/tv_online"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>
