<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/btnPlayerItem"
    android:layout_width="match_parent"
    android:layout_height="52dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/selector_tv_button"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp">

    <!-- App Icon -->
    <ImageView
        android:id="@+id/ivPlayerIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="Player Icon"
        android:src="@drawable/ic_video" />

    <!-- Name & Package Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPlayerName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:singleLine="true"
            android:text="VLC"
            android:textColor="@color/tv_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPlayerPackage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="org.videolan.vlc"
            android:textColor="@color/tv_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Default Status Pill -->
    <TextView
        android:id="@+id/tvDefaultBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tv_button_normal"
        android:paddingStart="8dp"
        android:paddingTop="3dp"
        android:paddingEnd="8dp"
        android:paddingBottom="3dp"
        android:text="DEFAULT"
        android:textColor="@color/tv_online"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

</LinearLayout>
