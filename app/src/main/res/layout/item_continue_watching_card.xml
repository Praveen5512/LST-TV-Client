<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardContainer"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:layout_margin="10dp"
    android:background="@drawable/selector_media_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="3dp">

    <!-- 16:9 Thumbnail Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="145dp">

        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Video Thumbnail"
            android:scaleType="centerCrop" />

        <!-- Fallback Video Icon -->
        <ImageView
            android:id="@+id/ivFallbackIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="Video Icon"
            android:src="@drawable/ic_video" />

        <!-- Time Remaining Badge (Bottom-Right) -->
        <TextView
            android:id="@+id/tvTimeBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_time_badge"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="00:18"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Orange Watch Progress Bar (Bottom of Thumbnail) -->
        <ProgressBar
            android:id="@+id/pbWatchProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progress="45"
            android:progressBackgroundTint="#40FFFFFF"
            android:progressTint="#F97316" />
    </FrameLayout>

    <!-- Title and Subtitle Info Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Interstellar"
            android:textColor="@color/tv_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCardSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="14.2 GB • Movies"
            android:textColor="@color/tv_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
