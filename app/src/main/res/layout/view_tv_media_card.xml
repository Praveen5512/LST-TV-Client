<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardContainer"
    android:layout_width="260dp"
    android:layout_height="200dp"
    android:layout_margin="8dp"
    android:background="@drawable/selector_media_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical">

    <!-- 16:9 Thumbnail / Icon Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="146dp"
        android:background="@color/tv_bg_dark">

        <!-- Image thumbnail (e.g., photo preview or video cover) -->
        <ImageView
            android:id="@+id/ivThumbnail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Media Thumbnail"
            android:scaleType="centerCrop" />

        <!-- Fallback / Centered Media Type Icon -->
        <ImageView
            android:id="@+id/ivIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:contentDescription="Media Type"
            android:src="@drawable/ic_video" />

        <!-- Watch Progress Bar (Bottom of Thumbnail) -->
        <ProgressBar
            android:id="@+id/pbWatchProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:progressTint="@color/tv_accent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Title and Subtitle Info Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/tvCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Interstellar.2014.1080p.mkv"
            android:textColor="@color/tv_text_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCardSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="4.2 GB • Movies"
            android:textColor="@color/tv_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
