<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_rounded"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvSelectTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:text="@string/server_select_title"
            android:textColor="@color/tv_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remote: [Right] Edit / Delete"
            android:textColor="@color/tv_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDiscoveryStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="@string/server_searching"
        android:textColor="@color/tv_accent"
        android:textSize="12sp" />

    <!-- Discovered & Saved Servers List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvServers"
        android:layout_width="match_parent"
        android:layout_height="210dp"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:fadeScrollbars="true"
        android:focusable="true"
        android:scrollbars="vertical" />

    <!-- Empty State -->
    <TextView
        android:id="@+id/tvEmptyMessage"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:text="@string/no_servers_found"
        android:textColor="@color/tv_text_muted"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Balanced Actions Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnManualIp"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/selector_tv_button"
            android:focusable="true"
            android:text="@string/manual_connect"
            android:textColor="@color/tv_accent"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnRescan"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/selector_tv_button"
            android:focusable="true"
            android:text="@string/btn_rescan"
            android:textColor="@color/tv_text_primary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnDismiss"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_margin="3dp"
            android:layout_weight="1"
            android:background="@drawable/selector_tv_button"
            android:focusable="true"
            android:text="@string/btn_close"
            android:textColor="@color/tv_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
