<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tv_bg_default"
    android:padding="32dp">

    <!-- Top Info Header -->
    <TextView
        android:id="@+id/tvAudioHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:text="@string/now_playing"
        android:textColor="@color/tv_accent"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Center Disc / Vinyl Artwork -->
    <FrameLayout
        android:id="@+id/discContainer"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="36dp">

        <!-- Outer Disc Ring -->
        <ImageView
            android:id="@+id/ivVinylDisc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Vinyl Disc"
            android:src="@drawable/ic_audio" />
    </FrameLayout>

    <!-- Track Title & Metadata -->
    <LinearLayout
        android:id="@+id/trackMetaContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/discContainer"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTrackTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Track Title"
            android:textColor="@color/tv_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvTrackArtist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Lossless Audio • Local Share"
            android:textColor="@color/tv_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Progress & Time -->
    <LinearLayout
        android:id="@+id/progressContainer"
        android:layout_width="600dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/trackMetaContainer"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <SeekBar
            android:id="@+id/audioSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="false"
            android:progressBackgroundTint="@color/tv_surface_elevated"
            android:progressTint="@color/tv_accent"
            android:thumbTint="@color/tv_accent" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/tvAudioCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="00:00"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvAudioTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="00:00"
                android:textColor="@color/tv_text_secondary"
                android:textSize="13sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Controls Row -->
    <LinearLayout
        android:id="@+id/controlsContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/progressContainer"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPrevious"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/selector_keypad_button"
            android:contentDescription="Previous Track"
            android:focusable="true"
            android:src="@drawable/ic_skip_previous" />

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/selector_tv_button"
            android:contentDescription="Play or Pause"
            android:focusable="true"
            android:src="@drawable/ic_pause" />

        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/selector_keypad_button"
            android:contentDescription="Next Track"
            android:focusable="true"
            android:src="@drawable/ic_skip_next" />

        <ImageButton
            android:id="@+id/btnExternal"
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:layout_marginStart="16dp"
            android:background="@drawable/selector_keypad_button"
            android:contentDescription="Open in External Player"
            android:focusable="true"
            android:src="@drawable/ic_open_in_new" />
    </LinearLayout>

    <!-- Bottom Queue Drawer -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/audio_queue"
            android:textColor="@color/tv_text_muted"
            android:textSize="13sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvQueue"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:focusable="true"
            android:orientation="horizontal" />
    </LinearLayout>

</RelativeLayout>
