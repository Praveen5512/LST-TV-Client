<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network & Wi-Fi Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- Leanback TV Feature Flags -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:label="@string/app_name"
        android:theme="@style/Theme.Leanback.TvClient"
        android:usesCleartextTraffic="true">

        <!-- TV Home Launcher Entry Point -->
        <activity
            android:name=".ui.browse.MainTvActivity"
            android:banner="@drawable/tv_banner"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:logo="@drawable/tv_banner"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Leanback Fullscreen Video Player Activity -->
        <activity
            android:name=".ui.player.VideoPlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Leanback.TvClient.Fullscreen" />

        <!-- Audio Player Activity -->
        <activity
            android:name=".ui.player.AudioPlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Leanback.TvClient" />

        <!-- Photo Slideshow Activity -->
        <activity
            android:name=".ui.photo.PhotoSlideshowActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@style/Theme.Leanback.TvClient.Fullscreen" />

    </application>

</manifest>
